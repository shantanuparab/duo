# Firebase config (free Spark plan)
# 1. Go to https://console.firebase.google.com
# 2. Create a new project (you can skip analytics)
# 3. Click the </> web app icon to register a web app
# 4. Copy the config values below
# 5. Go to Firestore Database → Create Database → Start in test mode
# 6. Rename this file to .env

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=your_app_id_here
